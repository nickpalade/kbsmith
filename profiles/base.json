{
  "_comment": "Applied by every profile. Token + speed tuning and a deny list that works in every permission mode.",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50",
    "BASH_MAX_OUTPUT_LENGTH": "15000"
  },
  "autoCompactEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "medium", "autoCompactWindow": 400000 },
    "claude-sonnet-5-5": { "autoCompactWindow": 400000 }
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
