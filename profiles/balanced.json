{
  "_comment": "Edits run without asking; shell commands outside the allow list still ask.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)", "Bash(git diff *)", "Bash(git log *)", "Bash(git show *)",
      "Bash(git add *)", "Bash(git commit *)",
      "Bash(node *)", "Bash(npm test *)", "Bash(npm run *)", "Bash(ls *)", "Bash(cat *)"
    ]
  }
}
